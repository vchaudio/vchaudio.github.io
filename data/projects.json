      "blocks": [
        {
          "type": "raw-banner",
          "class": "page-overview-banner--vm-xctrl page-overview-banner--vm-xctrl-hero",
          "html": "<img class=\"page-overview-banner__img vm-xctrl-hero-banner\" src=\"assets/vm-xctrl-hero-banner.webp\" alt=\"Behringer X-Touch universal control surface and Voicemeeter Potato mixer\" width=\"4096\" height=\"1104\" loading=\"eager\" decoding=\"async\" draggable=\"false\">"
        },
        {
          "type": "hero",
          "title": "VM-XCtrl",
          "lead": "Voicemeeter ↔ Behringer X-Touch bridge — tactile mixing, meters, and scribble feedback over UDP (XCtrl mode)."
        },
        {
          "type": "raw-flat",
          "html": "<div class=\"sub-content reveal\">\n        <p>\n          <strong>VM-XCtrl</strong> maps the X-Touch’s faders, encoders, buttons, and scribble strips to\n          <strong>VB-Audio Voicemeeter</strong> through the Voicemeeter API, with a UDP handshake in XCtrl mode. Run the\n          surface in <strong>XCtrl / MCU</strong> mode and keep Voicemeeter on one layer while your DAW or other tools\n          live on another — switch with the <strong>SMPTE</strong> button when you need to.\n        </p>\n        <div class=\"vm-xctrl-video reveal\">\n          <figure class=\"video-item\">\n            <div class=\"ratio-embed\">\n              <iframe title=\"VM-XCtrl — preview video\" src=\"https://www.youtube.com/embed/OcrzrS9EKOE\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen=\"\" loading=\"lazy\"></iframe>\n            </div>\n          </figure>\n        </div>\n        <div class=\"project-actions vm-xctrl-cta\">\n          <a class=\"project-link\" href=\"https://github.com/vchaudio/VM-XCtrl\" rel=\"noopener noreferrer\" target=\"_blank\">GitHub — source &amp; releases</a>\n          <a class=\"project-link project-link--secondary\" href=\"https://vchaudio.gumroad.com/l/VM-XCtrl\" rel=\"noopener noreferrer\" target=\"_blank\">Get a license (Gumroad)</a>\n          <a class=\"project-link project-link--secondary\" href=\"https://discord.gg/DzCBwq2e\" rel=\"noopener noreferrer\" target=\"_blank\">Discord — feedback &amp; support</a>\n        </div>\n      </div>"
        },
        {
          "type": "releases",
          "heading": "Download",
          "open": true,
          "wrapClass": "vm-xctrl-spoilers",
          "lead": "Builds and release notes on <a href=\"https://github.com/vchaudio/VM-Xctrl/releases\" rel=\"noopener noreferrer\" target=\"_blank\">GitHub Releases</a>.",
          "items": [
            {
              "version": "v.1.0.0.6 — API handling rework",
              "date": "17 Jan 2026",
              "badge": "latest",
              "href": "https://github.com/vchaudio/VM-Xctrl/releases/download/1.0.0.6/VM-Xctrl_v1.0.0.6.exe",
              "changes": [
                "Reworked startup flow for loading the Voicemeeter API.",
                "Scans the default Voicemeeter install folder (<code>C:\\Program Files (x86)\\VB\\Voicemeeter</code>) and locates required DLLs automatically — independent of a specific Voicemeeter version; tested with 3.1.1.9, 3.1.2.2, and intended for future releases.",
                "Older Voicemeeter versions may work but are untested; legacy API differences can limit some features.",
                "If DLLs are not found, you are prompted to pick the Voicemeeter installation folder manually.",
                "Voicemeeter folder can be changed anytime from the tray icon context menu."
              ]
            },
