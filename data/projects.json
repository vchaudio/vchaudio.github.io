        {
          "type": "accordion",
          "wrapClass": "vm-xctrl-spoilers",
          "items": [
            {
              "label": "Features",
              "open": true,
              "ordered": false,
              "items": [
                {
                  "strong": "Two main layers",
                  "text": " — Input (strips / channels) and Output (buses); switch without losing context."
                },
                {
                  "strong": "Nine faders on Input",
                  "text": " — eight channel faders plus one master."
                },
                {
                  "strong": "Channel metering",
                  "text": " — LED-style meters track Voicemeeter levels in real time."
                },
                {
                  "strong": "Scribble strips",
                  "text": " — line 1 for channel names; line 2 for labels or live gain in dB while you ride a fader; colour palettes differ for Input, Output, and AUX layers."
                },
                {
                  "strong": "Mute, Solo, Mono, M.C.",
                  "text": " — LED feedback mirrors Voicemeeter."
                },
                {
                  "strong": "AUX (send) layer",
                  "text": " — pick a channel, then adjust sends to A1–A5 and B1–B3; RECORD buttons toggle sends; meters show the selected channel and relative send levels."
                },
                {
                  "strong": "Preset recall",
                  "text": " — F1–F8 recall Voicemeeter snapshots with LED state."
                },
                {
                  "strong": "Media transport",
                  "text": " — play / pause / next / previous send OS-level media keys; LEDs follow playback."
                },
                {
                  "strong": "Connection robustness",
                  "text": " — UDP keep-alive, loss detection, and recovery; a “DISCONNECTED API” layer when Voicemeeter is offline, then automatic return when it’s back."
                },
                {
                  "strong": "FLIP",
                  "text": " — toggles absolute vs relative fader mode."
                },
                {
                  "strong": "Solo behaviour",
                  "text": " — when a channel is soloed, other mute LEDs blink like in Voicemeeter."
                },
                {
                  "strong": "Layer readout",
                  "text": " — in single XCtrl mode, the timecode fields show the active layer name."
                }
              ]
            },
            {
              "label": "Requirements",
              "open": true,
              "ordered": false,
              "items": [
                {
                  "strong": "VB-Audio Voicemeeter",
                  "text": " — Potato 3.1.1.9, Banana 2.1.1.9, or newer."
                },
                {
                  "strong": "Behringer X-Touch",
                  "text": " — XCtrl, XCtrl-MCU, or XCtrl-HUI mode."
                },
                {
                  "strong": "Network",
                  "text": " — PC and X-Touch on the same LAN with UDP allowed between them."
                }
              ]
            },
            {
              "label": "Getting started",
              "open": true,
              "ordered": true,
              "items": [
                "Put the X-Touch in <strong>XCtrl</strong> mode.",
                "Open Voicemeeter and enable the <strong>API</strong>.",
                "Launch <strong>VM-XCtrl</strong>; it discovers the surface and connects.",
                "Set the <strong>X-Touch IP</strong> in VM-XCtrl.",
                "On the X-Touch, set the <strong>PC IP</strong> (hover the tray icon in Windows — it shows your machine’s address).",
                "Mix Voicemeeter from the surface; use Gumroad for a license when you’re ready to go beyond evaluation limits described in the repo."
              ]
            }
          ]
        }
      ]
    }
  ]
