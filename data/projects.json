        {
          "type": "about",
          "heading": "About",
          "html": "<strong>Last Flag</strong> is a fast-paced 5v5 third-person hero shooter from Night Street Games—a studio co-founded by Imagine Dragons lead vocalist Dan Reynolds and his brother Mac Reynolds. Teams hide their flag, hunt the enemy's, and defend a capture to win matches framed as a wild 1970s televised game show. Built in Unreal Engine for PC (Steam and Epic Games Store)."
        },
        {
          "type": "responsibilities",
          "heading": "Responsibilities & Contributions",
          "items": [
            {
              "strong": "Sound design for gameplay, characters, and systems:",
              "text": "Created and implemented sound effects for character abilities, weapons, gunshots, impacts, finishers, executions, and various gameplay interactions across multiple playable heroes."
            },
            {
              "strong": "Character audio and gameplay feedback:",
              "text": "Designed and polished critical gameplay feedback systems, including hit ticks, damage reactions, healing feedback, heartbeat mechanics, and friendly/hostile ability variations to improve gameplay readability and player awareness."
            },
            {
              "strong": "MVP presentation audio:",
              "text": "Composed music and designed sound effects for MVP screens for 11 heroes."
            },
            {
              "strong": "UI and frontend audio design:",
              "text": "Created and implemented audio for menus, lobby systems, level progression, timers, panel transitions, frontend interactions, and other user interface elements."
            },
            {
              "strong": "Voice-over editing and integration:",
              "text": "Processed, edited, and integrated voice-over assets, ensuring consistency, clarity, and proper implementation within gameplay systems."
            },
            {
              "strong": "Dynamic mixing and HDR audio implementation:",
              "text": "Contributed to the game's dynamic mixing pipeline, including HDR-based mixing solutions to maintain clarity and impact during intense gameplay scenarios."
            },
            {
              "strong": "Technical audio design and implementation:",
              "text": "Developed and implemented audio logic, playback systems, and technical solutions using Wwise and Unreal Engine to support gameplay-driven audio behavior and improve maintainability."
            },
            {
              "strong": "Foley recording and asset creation:",
              "text": "Recorded and designed custom foley assets, including rollerblade movement across various surfaces, jumps, landings, and character movement details."
            },
            {
              "strong": "Audio polish and iteration:",
              "text": "Created a wide variety of supporting audio assets, environmental interactions, utility sounds, alarms, launch pads, character-specific variations, and continuous polish passes across multiple gameplay systems."
            }
          ]
        },
