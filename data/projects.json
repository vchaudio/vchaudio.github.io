        {
          "type": "about",
          "heading": "About",
          "html": "<strong>Moonray: Battle Lands</strong> is a free-to-play third-person PvP battle arena from Moonray PBC, set in a\n          science-fantasy world of floating islands and stylized combat. Players duel and team-fight with distinct heroes,\n          movement, and weapons across PC, Android, and PlayStation 5."
        },
        {
          "type": "responsibilities",
          "heading": "Responsibilities & Contributions",
          "items": [
            {
              "strong": "Full-cycle sound design for all in-game elements:",
              "text": "Created every sound from scratch. Performed and recorded custom foley, processed layers, and designed audio tailored\n                  to the game’s sci-fi aesthetic."
            },
            {
              "strong": "Implementation using Wwise and Unreal Engine 5:",
              "text": "Integrated sound assets through Wwise, UE5 Blueprint (and Niagara), ensuring responsive and performant playback\n                  in-game."
            },
            {
              "strong": "Blueprint-based audio system design:",
              "text": "Designed, developed, and maintained complex audio systems in Blueprints."
            },
            {
              "strong": "Voiceover coordination:",
              "text": "Collaborated with voice actors; handled announcer editing, processing, and in-engine implementation to maintain tone\n                  and clarity."
            },
            {
              "strong": "Interactive mixing:",
              "text": "Balanced dynamic real-time mixes, ensuring clear separation of layers and emotional pacing through intelligent use of\n                  volume automation, filters, and ducking."
            },
            {
              "strong": "Music composition:",
              "text": "Composed original interactive combat tracks, menu theme, and musical emotes."
            },
            {
              "strong": "Marketing:",
              "text": "Music composition and sound design for character reveal videos and comic-book video stories (excluding trailers)."
            },
            {
              "strong": "Platform-specific optimization:",
              "text": "Tuned audio assets and systems for PC, Android, and PlayStation 5, focusing on memory usage, CPU load, and perceived\n                  quality under hardware constraints."
            }
          ]
        },
