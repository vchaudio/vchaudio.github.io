        {
          "type": "raw-flat",
          "html": "<section class=\"resume-section reveal\" aria-labelledby=\"moonray-music-heading\">\n        <h2 id=\"moonray-music-heading\" class=\"resume-section__heading\">Music</h2>\n        <p class=\"project-section__date\">2022 — 2025</p>\n        <div class=\"project-portfolio-block project-portfolio-block--music\" id=\"moonray-soundtrack\">\n              <div class=\"vch-player\" data-vch-audio-player=\"\" data-artist=\"Valentyn Chumachenko\" data-playlist=\"Moonray Soundtrack\" aria-label=\"Moonray Soundtrack player\">\n                <div class=\"vch-player__now\">\n                  <div class=\"vch-player__now-top\">\n                    <div class=\"vch-player__art vch-player__art--album\">\n                      <img src=\"assets/moonray-logo-white.png\" alt=\"\" width=\"120\" height=\"120\" loading=\"lazy\" decoding=\"async\">\n                    </div>\n                    <div class=\"vch-player__now-body\">\n                      <div class=\"vch-player__controls-row\">\n                        <button type=\"button\" class=\"vch-player__play-btn\" aria-label=\"Play\">\n                          <svg class=\"vch-player__icon-play\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"></path></svg>\n                          <svg class=\"vch-player__icon-pause\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 5h4v14H6V5zm8 0h4v14h-4V5z\"></path></svg>\n                        </button>\n                        <div class=\"vch-player__meta\">\n                          <span class=\"vch-player__artist\">Valentyn Chumachenko</span>\n                          <span class=\"vch-player__title\">Moonray Soundtrack</span>\n                          <div class=\"vch-player__track-detail\">\n                            <p class=\"vch-player__track-desc\"></p>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div class=\"vch-player__seek-wrap\">\n                      <div class=\"vch-player__seek-row\">\n                        <span class=\"vch-player__time-cur\">0:00</span>\n                        <button type=\"button\" class=\"vch-player__seek\" aria-label=\"Seek\">\n                          <span class=\"vch-player__seek-rail\" aria-hidden=\"true\">\n                            <span class=\"vch-player__seek-fill\">\n                              <span class=\"vch-player__seek-shine\"></span>\n                            </span>\n                          </span>\n                          <span class=\"vch-player__seek-hover\" aria-hidden=\"true\"></span>\n                          <span class=\"vch-player__seek-thumb\" aria-hidden=\"true\"></span>\n                        </button>\n                        <span class=\"vch-player__time-dur\">0:00</span>\n                      </div>\n                    </div>\n                    <div class=\"vch-player__timelines-slot\">\n                      <button type=\"button\" class=\"vch-player__timelines-toggle\" aria-expanded=\"false\" aria-controls=\"moonray-timelines-viewport\" hidden=\"\">\n                        <span class=\"vch-player__timelines-toggle-label\">Timelines</span>\n                      </button>\n                      <div class=\"vch-player__timelines-panel\" id=\"moonray-timelines-panel\" aria-hidden=\"true\">\n                        <div class=\"vch-player__timelines-viewport\" id=\"moonray-timelines-viewport\"></div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <ol class=\"vch-player__tracks\" role=\"listbox\" aria-label=\"Tracks\">\n                  <li>\n                    <button type=\"button\" class=\"vch-player__track is-active\" data-audio-src=\"assets/audio/moonray/01-intro.mp3\" data-track-label=\"Intro\" data-track-desc=\"Original Intro\" aria-selected=\"true\">\n                      <span class=\"vch-player__track-num\">1</span>\n                      <span class=\"vch-player__track-art vch-player__track-art--logo\"><img src=\"assets/moonray-logo-black.png\" alt=\"\" width=\"38\" height=\"38\" loading=\"lazy\"></span>\n                      <span class=\"vch-player__track-title\">Moonray — Intro</span>\n                      <span class=\"vch-player__track-dur\">—:——</span>\n                    </button>\n                  </li>\n                  <li>\n                    <button type=\"button\" class=\"vch-player__track\" data-audio-src=\"assets/audio/moonray/02-throne-breakers.mp3\" data-track-label=\"Throne Breakers\" data-track-desc=\"Assembled interactive music track that plays during TDM/DM Mode\" aria-selected=\"false\">\n                      <span class=\"vch-player__track-num\">2</span>\n                      <span class=\"vch-player__track-art vch-player__track-art--logo\"><img src=\"assets/moonray-logo-black.png\" alt=\"\" width=\"38\" height=\"38\" loading=\"lazy\"></span>\n                      <span class=\"vch-player__track-title\">Moonray — Throne Breakers</span>\n                      <span class=\"vch-player__track-dur\">—:——</span>\n                    </button>\n                    <div class=\"vch-player__track-timeline-source\" hidden=\"\">TIMINGS\n0:00-0:25 — Suspense + Suspense with enemy near you\n0:25-3:12 — Combat SLOW segments (12 parts + transition)\n3:12-3:47 — Combat Critical Health segments (+ transitions in/out)\n3:47-4:12 — Death; Respawn Screen\n4:12-5:16 — Combat SPEEDUP (Intro, WarmUp; 3 main parts) + transition in\n5:16-6:01 — Pre-Combat segments (no hit registration for a certain amount of time, but combat could start at any moment) + transitions in/out\n6:01-6:52 — DOUBLE DAMAGE segment; plays during the buff (+ transitions)\n6:52-7:52 — Combat SPEEDUP (3 climax segments + 1 reload)\n7:56-8:38 — Win Screen</div>\n                  </li>\n                  <li>\n                    <button type=\"button\" class=\"vch-player__track\" data-audio-src=\"assets/audio/moonray/03-echo-blade.mp3\" data-track-label=\"Echo Blade\" data-track-desc=\"Assembled interactive music track that plays during Duel Mode\" aria-selected=\"false\">\n                      <span class=\"vch-player__track-num\">3</span>\n                      <span class=\"vch-player__track-art vch-player__track-art--logo\"><img src=\"assets/moonray-logo-black.png\" alt=\"\" width=\"38\" height=\"38\" loading=\"lazy\"></span>\n                      <span class=\"vch-player__track-title\">Moonray — Echo Blade</span>\n                      <span class=\"vch-player__track-dur\">—:——</span>\n                    </button>\n                    <div class=\"vch-player__track-timeline-source\" hidden=\"\">TIMINGS\n0:00-0:07 — Opening Part (Weapon Selector shown first time)\n0:07-0:13 — Waiting for Opponent state\n0:13-0:28 — Accolades Flow (VS, Round, Fight) — plays once for the match\n0:28-2:50 — COMBAT loops (12 parts). They will play by specific rules in the playlist (N Round).\n2:50-3:00 — COMBAT LowHP (for player)\n3:00-3:07 — ROUND END\n3:07-3:18 — General Waiting State\n3:19-3:27 — Transition to the Last Round theme\n3:28-4:14 — Last Round COMBAT loops (4 parts)\n4:15-4:36 — Climax for Last Round (when someone has critically low HP)\n4:36-4:42 — MATCH END / SCOREBOARD</div>\n                  </li>\n                  <li>\n                    <button type=\"button\" class=\"vch-player__track\" data-audio-src=\"assets/audio/moonray/04-deadly-rumors.mp3\" data-track-label=\"Deadly Rumors\" data-track-desc=\"Assembled interactive music track that plays during TDM/DM Mode\" aria-selected=\"false\">\n                      <span class=\"vch-player__track-num\">4</span>\n                      <span class=\"vch-player__track-art vch-player__track-art--logo\"><img src=\"assets/moonray-logo-black.png\" alt=\"\" width=\"38\" height=\"38\" loading=\"lazy\"></span>\n                      <span class=\"vch-player__track-title\">Moonray — Deadly Rumors</span>\n                      <span class=\"vch-player__track-dur\">—:——</span>\n                    </button>\n                    <div class=\"vch-player__track-timeline-source\" hidden=\"\">SUSPENSE — Enemy Close: 0:00 - 0:16\nTransition Suspense to Combat: 0:16 - 0:18\nCOMBAT PARTS (1-6) (6 different loops): 0:18 - 1:51\nTransition Combat to LOWHP: 1:51 - 1:53\nCOMBAT — LowHP (Loop): 1:53 - 2:09\nTransition LowHP to Combat: 2:09 - 2:11\nCOMBAT PARTS (7-10) (4 different loops): 2:11 - 3:13\nTransition Combat to Pre-Combat: 3:13 - 3:21\nPRE-COMBAT (2 loops): 3:21 - 3:53\nTransition PreCombat to Combat/LowHP: 3:53 - 3:55\nDEATH: 3:55 - 4:02\nWEAPON SELECTOR (Loop): 4:02 - 4:10\nPowerUp DoubleDamage: 4:21 - 4:29\nPowerUp MegaHealth / EnemyKill: 4:21 - 4:29</div>\n                  </li>\n                  <li>\n                    <button type=\"button\" class=\"vch-player__track\" data-audio-src=\"assets/audio/moonray/05-warrior.mp3\" data-track-label=\"Warrior\" data-track-desc=\"Assembled interactive music track that plays during TDM/DM Mode\" aria-selected=\"false\">\n                      <span class=\"vch-player__track-num\">5</span>\n                      <span class=\"vch-player__track-art vch-player__track-art--logo\"><img src=\"assets/moonray-logo-black.png\" alt=\"\" width=\"38\" height=\"38\" loading=\"lazy\"></span>\n                      <span class=\"vch-player__track-title\">Moonray — Warrior</span>\n                      <span class=\"vch-player__track-dur\">—:——</span>\n                    </button>\n                    <div class=\"vch-player__track-timeline-source\" hidden=\"\">SUSPENSE — Enemy Far: 0:00 - 0:15\nSUSPENSE — Enemy Close: 0:15 - 0:31\nCOMBAT PARTS (Different Loops): 0:31 - 2:46\nPRE-COMBAT (Loop): 2:46 - 3:02\nCOMBAT REPEAT: 3:02 - 3:18\nTransition COM to LOWHP: 3:18 - 3:20\nCOMBAT — LOWHP (Loop): 3:20 - 3:36\nTransition LOWHP to COM: 3:36 - 3:38\nCOMBAT REPEAT: 3:38 - 3:54\nDEATH: 3:54 - 4:01\nWEAPON SELECTOR (Loop): 4:01 - 4:24</div>\n                  </li>\n                  <li>\n                    <button type=\"button\" class=\"vch-player__track\" data-audio-src=\"assets/audio/moonray/06-menu-theme.mp3\" data-track-label=\"Menu Theme\" data-track-desc=\"Original looped music from main menu\" aria-selected=\"false\">\n                      <span class=\"vch-player__track-num\">6</span>\n                      <span class=\"vch-player__track-art vch-player__track-art--logo\"><img src=\"assets/moonray-logo-black.png\" alt=\"\" width=\"38\" height=\"38\" loading=\"lazy\"></span>\n                      <span class=\"vch-player__track-title\">Moonray — Menu Theme</span>\n                      <span class=\"vch-player__track-dur\">—:——</span>\n                    </button>\n                  </li>\n                </ol>\n                <p class=\"vch-player__footer\">\n                  Also on\n                  <a href=\"https://soundcloud.com/valentyn-chumachenko/sets/moonray-soundtrack/s-JiCMxK7Ur3m\" rel=\"noopener noreferrer\" target=\"_blank\">SoundCloud</a>\n                </p>\n                <audio class=\"vch-player__audio\" preload=\"none\"></audio>\n              </div>\n        </div>\n      </section>"
        },
        {
          "type": "raw-flat",
          "html": "<section class=\"resume-section reveal\" aria-labelledby=\"moonray-comic-heading\">\n        <h2 id=\"moonray-comic-heading\" class=\"resume-section__heading\">Comic Book Videos</h2>\n        <p class=\"project-section__date\">2022</p>\n        <div class=\"project-portfolio-block project-portfolio-block--comic\">\n          <div class=\"project-comic-layout\">\n            <div class=\"project-comic-trailers\" aria-label=\"Trailers\">\n              <div class=\"video-thumb-wrap\">\n                <button type=\"button\" class=\"video-thumb\" data-youtube-id=\"l3ZO2U1EyqU\" data-lightbox-heading=\"Moonray Comic Book\" data-lightbox-sub=\"Trailer · 2022\" aria-label=\"Play Moonray comic book trailer — part 1\">\n                  <img src=\"https://img.youtube.com/vi/l3ZO2U1EyqU/maxresdefault.jpg\" alt=\"\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\n                </button>\n                <p class=\"video-thumb-caption\"><strong>Trailer 1</strong>Comic Book</p>\n              </div>\n              <div class=\"video-thumb-wrap\">\n                <button type=\"button\" class=\"video-thumb\" data-youtube-id=\"MkKj27QFHEk\" data-lightbox-heading=\"Moonray Comic Book\" data-lightbox-sub=\"Trailer · 2022\" aria-label=\"Play Moonray comic book trailer — part 2\">\n                  <img src=\"https://img.youtube.com/vi/MkKj27QFHEk/maxresdefault.jpg\" alt=\"\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\n                </button>\n                <p class=\"video-thumb-caption\"><strong>Trailer 2</strong>Comic Book</p>\n              </div>\n            </div>\n            <div class=\"project-comic-previews\" aria-label=\"Chapters\">\n              <div class=\"video-thumb-wrap video-thumb-wrap--comic\">\n                <div class=\"comic-poster-reflect\">\n                  <button type=\"button\" class=\"video-thumb video-thumb--poster video-thumb--poster-portrait\" data-youtube-id=\"bRNzj4DhoEg\" data-lightbox-heading=\"Chapter I\" data-lightbox-sub=\"Music composing and Sound Design\" aria-label=\"Play Moonray Chapter I comic book video\">\n                    <img src=\"assets/moonray-comic-poster-1.png\" alt=\"Moonray — comic book video poster\" width=\"600\" height=\"900\" loading=\"lazy\" decoding=\"async\">\n                  </button>\n                  <div class=\"comic-poster-reflect__shine\" style=\"--comic-reflect: url('assets/moonray-comic-poster-1.png')\" aria-hidden=\"true\"></div>\n                </div>\n                <p class=\"video-thumb-caption\"><strong>Chapter I</strong>Music composing and Sound Design</p>\n              </div>\n              <div class=\"video-thumb-wrap video-thumb-wrap--comic\">\n                <div class=\"comic-poster-reflect\">\n                  <button type=\"button\" class=\"video-thumb video-thumb--poster video-thumb--poster-portrait\" data-youtube-id=\"RVx5XIvdomQ\" data-lightbox-heading=\"Chapter II\" data-lightbox-sub=\"Music Composing and Sound Design\" aria-label=\"Play Moonray Chapter II comic book video\">\n                    <img src=\"assets/moonray-comic-poster-2.png\" alt=\"Moonray 2 — comic book video poster\" width=\"600\" height=\"900\" loading=\"lazy\" decoding=\"async\">\n                  </button>\n                  <div class=\"comic-poster-reflect__shine\" style=\"--comic-reflect: url('assets/moonray-comic-poster-2.png')\" aria-hidden=\"true\"></div>\n                </div>\n                <p class=\"video-thumb-caption\"><strong>Chapter II</strong>Music Composing and Sound Design</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>"
